{
  "name": "s4l-surelc-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright bot that completes SureLC producer activation forms",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "postinstall": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pdf-parse": "^1.1.1",
    "playwright": "~1.59.1",
    "pino": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.11.0",
    "typescript": "^5.5.0"
  }
}
